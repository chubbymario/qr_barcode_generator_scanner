{
  "name": "qr_barcode_generator_scanner",
  "version": "1.6.0",
  "description": "Static QR code and barcode generator for GitHub Pages: styled QR codes with logos, 100+ barcode formats, batch export and label sheets.",
  "scripts": {
    "dev": "vite",
    "build": "npm run licenses && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/smoke.mjs",
    "icons": "python3 scripts/make-icons.py",
    "licenses": "node scripts/third-party-licenses.mjs",
    "predev": "npm run licenses"
  },
  "license": "0BSD",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "bwip-js": "^4.11.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "papaparse": "^5.7.1",
    "qr-code-styling": "^1.9.2",
    "zxing-wasm": "^3.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
